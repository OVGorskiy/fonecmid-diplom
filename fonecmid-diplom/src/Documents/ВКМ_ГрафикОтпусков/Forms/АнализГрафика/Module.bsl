#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.АдресВоВременномХранилище) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеГрафика = ПолучитьИзВременногоХранилища(Параметры.АдресВоВременномХранилище);
	УдалитьИзВременногоХранилища(Параметры.АдресВоВременномХранилище);
	
	ЗаполнитьДанныеФормы(ДанныеГрафика);
	ПостроитьДиаграммуОтпусков(ДанныеГрафика);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеФормы(ДанныеГрафика)
	
	ГодОтпусков = ДанныеГрафика.Год;
	
	ДанныеОтпусков.Очистить();
	Для Каждого СтрокаОтпуска Из ДанныеГрафика.Отпуска Цикл
		НоваяСтрока = ДанныеОтпусков.Добавить();
		НоваяСтрока.Сотрудник = СтрокаОтпуска.Сотрудник;
		НоваяСтрока.ДатаНачала = СтрокаОтпуска.ДатаНачала;
		НоваяСтрока.ДатаОкончания = СтрокаОтпуска.ДатаОкончания;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграммуОтпусков(ДанныеГрафика)
	
	Диаграмма.Очистить();
	Диаграмма.Обновление = Ложь;
	Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
	
	СерияОтпусков = Диаграмма.УстановитьСерию("Отпуска");
	СерияОтпусков.Текст = "Отпуска сотрудников";
	
	НачалоПериода = НачалоГода(?(ЗначениеЗаполнено(ДанныеГрафика.Год), Дата(ДанныеГрафика.Год, 1, 1), ТекущаяДатаСеанса()));
	КонецПериода = КонецГода(НачалоПериода);
	
	Для Каждого СтрокаОтпуска Из ДанныеГрафика.Отпуска Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала)
			Или Не ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли;
		
		Точка = Диаграмма.УстановитьТочку(СтрокаОтпуска.Сотрудник);
		Точка.Текст = Строка(СтрокаОтпуска.Сотрудник);
		Точка.Расшифровка = СтрокаОтпуска.Сотрудник;
		
		Значение = Диаграмма.ПолучитьЗначение(Точка, СерияОтпусков);
		Значение.Расшифровка = СтрокаОтпуска.Сотрудник;
		
		Интервал = Значение.Добавить();
		Интервал.Начало = СтрокаОтпуска.ДатаНачала;
		Интервал.Конец = СтрокаОтпуска.ДатаОкончания;
		Интервал.Расшифровка = СтрокаОтпуска.Сотрудник;
		
		КоличествоКалендарныхДней = (СтрокаОтпуска.ДатаОкончания - СтрокаОтпуска.ДатаНачала) / (60 * 60 * 24) + 1;
		Интервал.Текст = СтрШаблон("%1 дн.", КоличествоКалендарныхДней);
		
		// Отпуск длиннее 28 календарных дней выделяется цветом.
		Если КоличествоКалендарныхДней > 28 Тогда
			Интервал.Цвет = ЦветаСтиля.ЦветАкцента;
		КонецЕсли;
		
	КонецЦикла;
	
	Диаграмма.УстановитьПолныйИнтервал(НачалоПериода, КонецПериода);
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

#КонецОбласти
