#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаОтпуска Из ОтпускаСотрудников Цикл
		
		Если СтрокаОтпуска.ДатаНачала = '00010101' Или СтрокаОтпуска.ДатаОкончания = '00010101' Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаОтпуска.ДатаОкончания < СтрокаОтпуска.ДатаНачала Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Поле = "ОтпускаСотрудников[0].ДатаОкончания";
			Сообщение.Текст = "Дата окончания отпуска не может быть раньше даты начала.";
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;
		
		Если Год(СтрокаОтпуска.ДатаНачала) <> Год Или Год(СтрокаОтпуска.ДатаОкончания) <> Год Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Поле = "ОтпускаСотрудников[0].ДатаНачала";
			Сообщение.Текст = СтрШаблон(
				"Период отпуска сотрудника %1 должен находиться в пределах года %2.",
				СтрокаОтпуска.Сотрудник, Год);
			Сообщение.Сообщить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
