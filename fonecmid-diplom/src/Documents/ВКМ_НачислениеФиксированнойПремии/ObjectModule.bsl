#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВКМ_НачисленияПремий.Очистить();
	Движения.ВКМ_УдержанияСотрудников.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	
	Движения.ВКМ_НачисленияПремий.Записывать = Истина;
	Движения.ВКМ_УдержанияСотрудников.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	ПериодРегистрации = НачалоМесяца(МесяцНачисления);
	СтавкаНДФЛ = 13;
	
	Для Каждого СтрокаСписка Из СписокСотрудников Цикл
		
		СуммаПремии = СтрокаСписка.СуммаПремии;
		СуммаНДФЛ = Окр(СуммаПремии * СтавкаНДФЛ / 100, 2);
		
		// Начисление разовой фиксированной премии.
		Движение = Движения.ВКМ_НачисленияПремий.Добавить();
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.Премия;
		Движение.Сотрудник = СтрокаСписка.Сотрудник;
		Движение.Результат = СуммаПремии;
		
		// Удержание НДФЛ с премии.
		Движение = Движения.ВКМ_УдержанияСотрудников.Добавить();
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Движение.Сотрудник = СтрокаСписка.Сотрудник;
		Движение.Результат = СуммаНДФЛ;
		
		// Задолженность перед сотрудником: премия за вычетом удержанного НДФЛ.
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Сотрудник = СтрокаСписка.Сотрудник;
		Движение.Сумма = СуммаПремии - СуммаНДФЛ;
		
	КонецЦикла;
	
	Движения.Записать();
	
КонецПроцедуры

#КонецОбласти

