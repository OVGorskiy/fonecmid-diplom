#Область СлужебныеПроцедурыИФункции
Функция ОтправитьСообщениеВTelegram(ТекстСообщения) Экспорт
    
    Попытка
        Защита = Новый ЗащищенноеСоединениеOpenSSL();
        Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30, Защита);
        
        СтруктураЗапроса = Новый Структура;
        СтруктураЗапроса.Вставить("chat_id", Константы.КСЮ_ИдентификаторГруппыДляОповещения.Получить());
        СтруктураЗапроса.Вставить("text", ТекстСообщения);
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
        СтрокаJSON = ЗаписьJSON.Закрыть();
        
        Токен = Константы.КСЮ_ТокенУправленияТелеграмБотом.Получить();
        Запрос = Новый HTTPЗапрос("/bot" + Токен + "/sendMessage");
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
        
        Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
        
        
        
        Если Ответ.КодСостояния = 200 Тогда
           	Возврат Истина; 
        Иначе    
            ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
            ЗаписьЖурналаРегистрации(
                "Telegram.ОтправкаСообщения",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ,
                "Не удалось отправить сообщение. Код: " + Ответ.КодСостояния + 
                ". Ответ: " + ТелоОтвета
            );
            Возврат Ложь;
        КонецЕсли;
        
    Исключение
        ЗаписьЖурналаРегистрации(
            "Telegram.ОтправкаСообщения",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            "Исключение при отправке: " + ОписаниеОшибки()
        );
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

Процедура ОтправитьНакопленныеУведомления() Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Уведомления.Ссылка КАК Ссылка,
        |    Уведомления.ТекстСообщения КАК ТекстСообщения
        |ИЗ
        |    Справочник.Уведомления КАК Уведомления
        |УПОРЯДОЧИТЬ ПО
        |    Уведомления.Ссылка";
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Пока Выборка.Следующий() Цикл
        
        Успешно = ОтправитьСообщениеВTelegram(Выборка.ТекстСообщения);
        
        Если Успешно Тогда          
            Попытка
                Выборка.Ссылка.ПолучитьОбъект().Удалить();
            Исключение
                ЗаписьЖурналаРегистрации(
                    "Telegram.УдалениеУведомления",
                    УровеньЖурналаРегистрации.Ошибка,
                    ,
                    Выборка.Ссылка,
                    "Не удалось удалить элемент справочника Уведомления: " + ОписаниеОшибки()
                );
            КонецПопытки;
        КонецЕсли;
        
        
    КонецЦикла;
    
КонецПроцедуры

#КонецОбласти